{
  "name": "knoux-player-x",
  "version": "1.0.0",
  "description": "KNOUX Player X™ - The Cinematic Intelligence Media System",
  "main": "desktop/main/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve --config config/webpack.renderer.dev.js",
    "electron:dev": "cross-env NODE_ENV=development electron-forge start",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "webpack --config config/webpack.renderer.prod.js",
    "build:main": "webpack --config config/webpack.main.prod.js",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,css,scss,md}\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "ci:smoke": "node scripts/ci/smoke.js",
    "test": "jest --passWithNoTests",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:watch": "jest --watch",
    "update": "node scripts/update.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.0",
    "@reduxjs/toolkit": "^2.0.0",
    "framer-motion": "^10.16.0",
    "electron": "28.0.0",
    "electron-updater": "6.1.8",
    "@ffmpeg/ffmpeg": "^0.12.7",
    "@ffmpeg/core": "^0.11.0",
    "howler": "^2.2.4",
    "i18next": "^23.0.0",
    "react-i18next": "^13.0.0",
    "zustand": "^4.0.0",
    "immer": "^10.0.0",
    "nanoid": "^5.0.0",
    "classnames": "^2.3.0",
    "lodash": "^4.17.0",
    "axios": "^1.5.0",
    "socket.io-client": "^4.7.0",
    "chroma-js": "^2.4.0",
    "react-hotkeys-hook": "^4.4.0",
    "react-dropzone": "^14.2.0",
    "react-resizable": "^3.0.0",
    "react-virtualized": "^9.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/user-event": "^14.0.0",
    "electron-forge": "^7.2.0",
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-rpm": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "@electron-forge/plugin-webpack": "^7.2.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.0.0",
    "file-loader": "^6.2.0",
    "style-loader": "^3.0.0",
    "sass": "^1.97.2",
    "sass-loader": "^13.0.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^4.15.0",
    "html-webpack-plugin": "^5.5.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "cross-env": "^7.0.0",
    "concurrently": "^8.0.0",
    "nodemon": "^3.0.0"
  },
  "keywords": [
    "media-player",
    "video-player",
    "audio-player",
    "electron",
    "react",
    "typescript",
    "ffmpeg",
    "hardware-acceleration",
    "neon-ui"
  ],
  "author": "Sadek Elgazar (KNOUX) - أبو ريتاج",
  "license": "Proprietary",
  "repository": {
    "type": "git",
    "url": "https://github.com/knuux7-ctrl/KNOX-Player-X-.git"
  },
  "bugs": {
    "url": "https://github.com/knuux7-ctrl/KNOX-Player-X-/issues"
  },
  "homepage": "https://knoux.tech",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
